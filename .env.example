# ─── Auth.js (required in production) ───────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ─── Upstash Redis (optional — falls back to in-memory rate limit in dev) ───
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=1 m

# ─── Server-only secrets (never prefix with NEXT_PUBLIC_) ───────────────────
INTERNAL_API_KEY=change-me-in-production
